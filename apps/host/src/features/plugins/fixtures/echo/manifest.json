{
  "protocolVersion": 1,
  "id": "echo",
  "name": "Echo",
  "version": "1.0.0",
  "kind": "provider",
  "main": "index.ts",
  "permissions": [],
  "settingsSchema": {
    "greeting": { "kind": "string", "label": "Greeting", "default": "hello" },
    "repeat": { "kind": "number", "label": "Repeat", "min": 1, "max": 3, "default": 1 },
    "accountKey": { "kind": "string", "label": "Account key", "default": "acct-a" },
    "sessions": { "kind": "boolean", "label": "Keep vendor sessions", "default": false },
    "blankCwd": { "kind": "string", "label": "Folder name whose route has no known account", "default": "" },
    "routeInfo": { "kind": "select", "label": "route-info", "options": ["ok", "fail", "hang"], "default": "ok" }
  }
}
