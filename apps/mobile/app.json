{
  "expo": {
    "name": "Ori Kami",
    "slug": "orikami",
    "scheme": "orikami",
    "version": "0.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.legendarykoi.orikami.mobile",
      "supportsTablet": true,
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ori Kami connects to Ori Kami on your computer over your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "ts.net": { "NSIncludesSubdomains": true, "NSExceptionAllowsInsecureHTTPLoads": true }
          }
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Ori Kami uses the camera to scan the pairing QR code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
