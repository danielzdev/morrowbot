{
  "expo": {
    "name": "Ori Bot",
    "slug": "oribot",
    "scheme": "oribot",
    "version": "0.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.legendarykoi.oribot.mobile",
      "supportsTablet": true,
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ori Bot connects to Ori Bot on your computer over your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "ts.net": { "NSIncludesSubdomains": true, "NSExceptionAllowsInsecureHTTPLoads": true }
          }
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Ori Bot uses the camera to scan the pairing QR code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ori Bot attaches the photos you pick to your messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
